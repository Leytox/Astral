    "@nestjs/axios": "^12.0.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.0.1",
    "@nestjs/serve-static": "^12.0.0",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/terminus": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^12.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/types": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@types/bcrypt": "^6.0.0",
    "@willsoto/nestjs-prometheus": "^6.1.1",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "better-sse": "^0.16.1",
    "bullmq": "^6.3.4",
    "cache-manager": "^7.2.9",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "file-type": "^22.0.2",
    "geoip-lite": "^2.0.3",
    "handlebars": "^4.7.9",
